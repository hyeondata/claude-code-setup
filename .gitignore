# Allowlist: new personal/runtime files are ignored unless explicitly included.
/*
!/.gitignore
!/README.md
!/claude-sync
!/config/
/config/*
!/config/CLAUDE.md.tmpl
!/config/plugins.json
!/automation/
/automation/*
!/automation/memory_hooks.py
!/automation/memory_cli.py
!/automation/episodic_search.mjs
!/automation/AUTOMATION.md.tmpl
!/scripts/
/scripts/*
!/scripts/bootstrap.py
!/scripts/sync.py
!/tests/
/tests/*
!/tests/test_bootstrap.py
!/tests/test_sync.py
!/docs/
/docs/*
!/docs/*.md

# Explicit defense for vault data and machine-local state.
/obsidian/
/vault/
/.claude/
/.local/
/setup-backups/
/automation/drafts/
/automation/config.json
/automation/AUTOMATION.md
**/.DS_Store
**/__pycache__/
*.pyc
.env
.env.*
*.pem
*.key
*.p12
*.sqlite*
*.db
*.jsonl
*.log
node_modules/
