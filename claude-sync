#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
if [ -L "$script_dir/scripts/sync.py" ]; then
    printf '%s\n' 'Error: scripts/sync.py must not be a symlink.' >&2
    exit 1
fi

if [ -n "${CLAUDE_SYNC_PYTHON:-}" ]; then
    if "$CLAUDE_SYNC_PYTHON" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "$CLAUDE_SYNC_PYTHON" "$script_dir/scripts/sync.py" "$@"
    fi
    printf '%s\n' 'Error: CLAUDE_SYNC_PYTHON must point to an executable Python 3.10+.' >&2
    exit 1
fi

for candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$candidate" >/dev/null 2>&1 &&
        "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "$candidate" "$script_dir/scripts/sync.py" "$@"
    fi
done

printf '%s\n' 'Error: install Python 3.10+ (for example python3.11), or set CLAUDE_SYNC_PYTHON.' >&2
exit 1
